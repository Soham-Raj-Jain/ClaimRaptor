# ClaimRaptor environment variables
#
# Copy this file to .env and fill in your own values.
# .env is git-ignored and must never be committed.

# Nace API key for NDI parsing and Drex decisions.
# Get it from your Nace dashboard.
NACE_API_KEY=

# DeepInfra API key used for the Qwen baseline model.
# Get it from your DeepInfra dashboard.
DEEPINFRA_API_KEY=
